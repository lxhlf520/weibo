# ===== 本地 PostgreSQL 连接配置（历史迁移用，可留默认） =====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=weibo_experiment

# ===== 本地 MongoDB（无认证） =====
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=test_experiment

# ===== Supabase 连接配置（可留空，核心数据走 MongoDB） =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== SMTP 邮件通知（可留空则跳过告警邮件） =====
# 163 邮箱授权码获取：登录 163 邮箱 → 设置 → POP3/SMTP/IMAP → 开启并生成授权码
SMTP_USER=
SMTP_AUTH_CODE=
# 告警收件邮箱（留空则跳过发送）
TO_EMAIL=
