# ================= 运行日志 =================
*.log
logs/

# ================= 浏览器 profile（含登录态） =================
chrome-*/
**/chrome-weibo-profile*/
.git-backup/

# ================= 嵌套 git 仓库（源机平台遗留的 .git；被忽略后 git 将平台目录按普通目录处理） =================
**/.git/

# ================= Python =================
__pycache__/
.venv/

